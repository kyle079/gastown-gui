# systemd service for the mayor preview refresh loop.
# Triggered by gastown-gui-autodeploy.timer every minute.
# Fetches origin/master; refreshes only if HEAD advanced or preview is unhealthy.
#
# One-time install (run as root):
#   cp scripts/gastown-gui-autodeploy.service /etc/systemd/system/
#   cp scripts/gastown-gui-autodeploy.timer  /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now gastown-gui-autodeploy.timer

[Unit]
Description=Gastown GUI preview auto-refresh
After=network.target

[Service]
Type=oneshot
User=kyle
WorkingDirectory=/home/kyle/gt/gastown_gui/mayor/rig
Environment=PREVIEW_REPO_DIR=/home/kyle/gt/gastown_gui/mayor/rig
ExecStart=/bin/bash /home/kyle/gt/gastown_gui/mayor/rig/scripts/autodeploy-poll.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gastown-gui-preview-refresh
