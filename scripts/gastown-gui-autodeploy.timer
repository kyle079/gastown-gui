# Timer: poll origin/master every minute and auto-refresh the mayor preview if
# HEAD advanced or the preview processes died.
#
# One-time install (run as root):
#   cp scripts/gastown-gui-autodeploy.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now gastown-gui-autodeploy.timer

[Unit]
Description=Gastown GUI auto-deploy timer

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
Persistent=true

[Install]
WantedBy=timers.target
